# Supabase PostgreSQL: application traffic uses transaction mode; migrations use session mode.
DATABASE_URL=postgresql://postgres.<project-ref>:[URL-ENCODED-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<project-ref>:[URL-ENCODED-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Generate a unique server signing secret with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Supabase Storage credentials stay in this server-only file or deployment secret store.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-server-only-service-role-key

# Comma-separated browser origins; never use * with credentialed CORS.
AGRIROUTE_CORS_ORIGINS=http://localhost:5173
MATCHING_ATTEMPT_COOLDOWN_SECONDS=60
ROUTING_FAILED_ATTEMPT_THRESHOLD=3
ROUTING_QUALITY_REJECTION_THRESHOLD=2
ROUTING_URGENT_DEADLINE_DAYS=1
ROUTING_COMBINED_FAILURE_THRESHOLD=2
